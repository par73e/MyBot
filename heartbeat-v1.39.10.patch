+	if runner.calls != 0 {
+		t.Fatal("ran before due time")
+	}
+	if err := engine.Tick(t.Context(), now); err != nil {
+		t.Fatal(err)
+	}
+	restarted := Engine{Store: Store{Path: store.Path}, Runner: runner}
+	if err := restarted.Tick(t.Context(), now.Add(time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	got := onlyTask(t, store)
+	if runner.calls != 1 || got.Enabled || got.History[0].Status != "completed" || got.History[0].SessionID != "session-1" {
+		t.Fatalf("calls=%d task=%+v", runner.calls, got)
+	}
+}
+func TestDeliveryRetryDoesNotRerunAgent(t *testing.T) {
+	store, _, now := fixture(t)
+	target := Target{ConnectionID: "weixin-weixin", ChatID: "owner", ChatType: "dm"}
+	if err := store.Update(t.Context(), "task-1", func(t *Task) error { t.Target = &target; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	runner := &testRunner{result: Execution{Text: "report"}}
+	sender := &testSender{err: errors.New("network unavailable")}
+	engine := Engine{Store: store, Runner: runner, Sender: sender}
+	if err := engine.Tick(t.Context(), now); err == nil {
+		t.Fatal("missing send failure")
+	}
+	if got := onlyTask(t, store); got.History[0].Status != "delivery_pending" {
+		t.Fatalf("task=%+v", got)
+	}
+	sender.err = nil
+	if err := engine.Tick(t.Context(), now.Add(time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	if runner.calls != 1 || sender.calls != 2 || sender.target != target || sender.texts[1] != "report" {
+		t.Fatalf("runner=%+v sender=%+v", runner, sender)
+	}
+	if got := onlyTask(t, store); got.Enabled || got.History[0].Status != "delivered" {
+		t.Fatalf("task=%+v", got)
+	}
+}
+func TestMessageReminderUsesNoAgent(t *testing.T) {
+	store, _, now := fixture(t)
+	if err := store.Update(t.Context(), "task-1", func(t *Task) error {
+		t.Kind = "message"
+		t.Target = &Target{ConnectionID: "wx", ChatID: "owner"}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	runner := &testRunner{}
+	sender := &testSender{}
+	if err := (Engine{Store: store, Runner: runner, Sender: sender}).Tick(t.Context(), now); err != nil {
+		t.Fatal(err)
+	}
+	if runner.calls != 0 || sender.calls != 1 || sender.texts[0] != "prepare report" {
+		t.Fatalf("runner=%+v sender=%+v", runner, sender)
+	}
+}
+func TestWorkerLeasePreventsOverlapAndPreservesConcurrentEdit(t *testing.T) {
+	store, _, now := fixture(t)
+	runner := &testRunner{entered: make(chan struct{}), resume: make(chan struct{}), result: Execution{Text: "answer"}}
+	engine := Engine{Store: store, Runner: runner}
+	done := make(chan error, 1)
+	go func() { done <- engine.Tick(t.Context(), now) }()
+	<-runner.entered
+	if err := (Engine{Store: store, Runner: &testRunner{}}).Tick(t.Context(), now); err == nil {
+		t.Fatal("second worker acquired active lease")
+	}
+	if err := store.Update(t.Context(), "task-1", func(t *Task) error { t.Title = "edited while running"; t.Enabled = false; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	close(runner.resume)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if got := onlyTask(t, store); got.Title != "edited while running" || got.Enabled || got.History[0].Result != "answer" {
+		t.Fatalf("lost concurrent edit: %+v", got)
+	}
+}
+func TestRemovedTaskIsNotResurrectedByCompletion(t *testing.T) {
+	store, _, now := fixture(t)
+	runner := &testRunner{entered: make(chan struct{}), resume: make(chan struct{})}
+	done := make(chan error, 1)
+	go func() { done <- (Engine{Store: store, Runner: runner}).Tick(t.Context(), now) }()
+	<-runner.entered
+	if err := store.Edit(t.Context(), func(tasks *[]Task) error { *tasks = nil; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	close(runner.resume)
+	<-done
+	tasks, err := store.List(t.Context())
+	if err != nil || len(tasks) != 0 {
+		t.Fatalf("tasks=%v err=%v", tasks, err)
+	}
+}
+func TestInterruptedRunNeedsExplicitRetry(t *testing.T) {
+	store, _, now := fixture(t)
+	if err := store.Update(t.Context(), "task-1", func(t *Task) error {
+		t.LastRunAt = now.UnixMilli()
+		t.History = []Run{{StartedAt: now.UnixMilli(), Status: "running"}}
+		return nil
+	}); err != nil {
+		t.Fatal(err)
+	}
+	runner := &testRunner{result: Execution{Text: "recovered"}}
+	engine := Engine{Store: store, Runner: runner}
+	if err := engine.Tick(t.Context(), now); err != nil {
+		t.Fatal(err)
+	}
+	if got := onlyTask(t, store); runner.calls != 0 || got.Enabled || got.History[0].Status != "interrupted" {
+		t.Fatalf("task=%+v", got)
+	}
+	if err := engine.Trigger(t.Context(), "task-1", now.Add(time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	if runner.calls != 1 {
+		t.Fatalf("calls=%d", runner.calls)
+	}
+}
+func TestStoreConcurrentAddsDoNotLoseTasks(t *testing.T) {
+	store, base, _ := fixture(t)
+	var wg sync.WaitGroup
+	for i := range 8 {
+		wg.Go(func() {
+			task := base
+			task.ID = string(rune('a' + i))
+			if err := store.Add(t.Context(), task); err != nil {
+				t.Error(err)
+			}
+		})
+	}
+	wg.Wait()
+	tasks, err := store.List(t.Context())
+	if err != nil || len(tasks) != 9 {
+		t.Fatalf("tasks=%d err=%v", len(tasks), err)
+	}
+}
+
+func TestAmbiguousDeliveryStopsAutomaticReplay(t *testing.T) {
+	store, _, now := fixture(t)
+	if err := store.Update(t.Context(), "task-1", func(t *Task) error { t.Target = &Target{ConnectionID: "wx", ChatID: "owner"}; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	runner := &testRunner{result: Execution{Text: "answer"}}
+	sender := &testSender{err: ErrDeliveryUncertain}
+	engine := Engine{Store: store, Runner: runner, Sender: sender}
+	if err := engine.Tick(t.Context(), now); !errors.Is(err, ErrDeliveryUncertain) {
+		t.Fatalf("err=%v", err)
+	}
+	if err := engine.Tick(t.Context(), now.Add(time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	if runner.calls != 1 || sender.calls != 1 || onlyTask(t, store).History[0].Status != "delivery_uncertain" {
+		t.Fatal("ambiguous notification replayed")
+	}
+}
+func TestFailedAgentIsNotSentOrRepeatedAsSuccessfulOneShot(t *testing.T) {
+	store, _, now := fixture(t)
+	if err := store.Update(t.Context(), "task-1", func(t *Task) error { t.Target = &Target{ConnectionID: "wx", ChatID: "owner"}; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	runner := &testRunner{err: errors.New("model unavailable")}
+	sender := &testSender{}
+	engine := Engine{Store: store, Runner: runner, Sender: sender}
+	if err := engine.Tick(t.Context(), now); err == nil {
+		t.Fatal("execution failure hidden")
+	}
+	if err := engine.Tick(t.Context(), now.Add(time.Minute)); err != nil {
+		t.Fatal(err)
+	}
+	got := onlyTask(t, store)
+	if runner.calls != 1 || sender.calls != 0 || got.Enabled || got.History[0].Status != "failed" {
+		t.Fatalf("task=%+v", got)
+	}
+}
+
+type advancingRunner struct {
+	calls int
+	now   *time.Time
+}
+
+func (r *advancingRunner) Run(context.Context, Task) (Execution, error) {
+	r.calls++
+	*r.now = r.now.Add(2 * time.Hour)
+	return Execution{Text: "done"}, nil
+}
+func TestQueuedTaskRechecksExpiryAfterEarlierTaskCompletes(t *testing.T) {
+	store, base, now := fixture(t)
+	next := base
+	next.ID = "expires-in-queue"
+	next.EndsAt = now.Add(time.Hour).Format(time.RFC3339)
+	if err := store.Add(t.Context(), next); err != nil {
+		t.Fatal(err)
+	}
+	clock := now
+	runner := &advancingRunner{now: &clock}
+	engine := Engine{Store: store, Runner: runner, Clock: func() time.Time { return clock }}
+	if err := engine.Tick(t.Context(), now); err != nil {
+		t.Fatal(err)
+	}
+	tasks, err := store.List(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if runner.calls != 1 || len(tasks[1].History) != 0 {
+		t.Fatalf("expired queued job executed: calls=%d task=%+v", runner.calls, tasks[1])
+	}
+}
diff --git a/internal/heartbeat/schedule.go b/internal/heartbeat/schedule.go
new file mode 100644
--- /dev/null
+++ b/internal/heartbeat/schedule.go
@@ -0,0 +1,492 @@
+package heartbeat
+
+import (
+	"strconv"
+	"strings"
+	"time"
+)
+
+// parseInterval converts a string like "5m", "1h", "30s" to time.Duration.
+// Suffix after '|' is stripped (e.g. "24h|daily@09:00" -> "24h").
+// Empty or invalid strings return 0, nil (task will be skipped).
+func parseInterval(s string) (time.Duration, error) {
+	if idx := strings.Index(s, "|"); idx >= 0 {
+		s = s[:idx]
+	}
+	if len(s) == 0 {
+		return 0, nil
+	}
+	// Support common suffixed intervals
+	switch s[len(s)-1] {
+	case 's', 'm', 'h':
+		return time.ParseDuration(s)
+	default:
+		// Try "Xm" as default assumption
+		return time.ParseDuration(s + "m")
+	}
+}
+
+// isCronExpr returns true when s looks like a valid 5-field cron expression
+// (e.g. "0 * * * *", "*/15 * * * *", "0 9 * * 1-5"). Rejects expressions with
+// out-of-range values (e.g. "99 * * * *") that would never match.
+func isCronExpr(s string) bool {
+	fields := strings.Fields(s)
+	if len(fields) != 5 {
+		return false
+	}
+	// min, hour, dom, month, dow — dom/month are 1-based (0 can never match
+	// time.Day()/time.Month()), dow is 0-7 (7 = Sunday alias, matched in cronDue).
+	limits := []int{59, 23, 31, 12, 7}
+	mins := []int{0, 0, 1, 1, 0}
+	for i, f := range fields {
+		if f == "" {
+			return false
+		}
+		for _, c := range f {
+			if !strings.ContainsRune("0123456789*/-,", c) {
+				return false
+			}
+		}
+		// Reject out-of-range values in each field, plus zero/empty step
+		// values ("*/0" never fires) and descending ranges ("5-1" never matches).
+		for part := range strings.SplitSeq(f, ",") {
+			part = strings.TrimSpace(part)
+			base := part
+			if stepBase, stepText, ok := strings.Cut(part, "/"); ok {
+				step, err := strconv.Atoi(stepText)
+				if err != nil || step < 1 {
+					return false
+				}
+				base = stepBase
+			}
+			if base == "*" {
+				continue
+			}
+			if loText, hiText, ok := strings.Cut(base, "-"); ok {
+				lo, err1 := strconv.Atoi(loText)
+				hi, err2 := strconv.Atoi(hiText)
+				if err1 != nil || err2 != nil || lo < mins[i] || hi > limits[i] || lo > hi {
+					return false
+				}
+			} else {
+				v, err := strconv.Atoi(base)
+				if err != nil || v < mins[i] || v > limits[i] {
+					return false
+				}
+			}
+		}
+	}
+	return true
+}
+
+// cronMatchField checks whether a single value matches a cron field pattern.
+func cronMatchField(pattern string, value, minValue, maxValue int) bool {
+	// Handle comma-separated lists
+	for part := range strings.SplitSeq(pattern, ",") {
+		part = strings.TrimSpace(part)
+		if cronMatchSingle(part, value, minValue, maxValue) {
+			return true
+		}
+	}
+	return false
+}
+
+func cronMatchSingle(pattern string, value, minValue, maxValue int) bool {
+	// Handle step values: */15, 1-10/2, 1/2. Wildcard steps are
+	// anchored at the field minimum, which matters for 1-based fields.
+	if rangePart, stepStr, ok := strings.Cut(pattern, "/"); ok {
+		step, err := strconv.Atoi(stepStr)
+		if err != nil || step <= 0 {
+			return false
+		}
+		if rangePart == "*" {
+			return value >= minValue && value <= maxValue && (value-minValue)%step == 0
+		}
+		// Range with step: 1-10/2
+		if lowText, highText, ok := strings.Cut(rangePart, "-"); ok {
+			low, _ := strconv.Atoi(lowText)
+			high, _ := strconv.Atoi(highText)
+			if value < low || value > high {
+				return false
+			}
+			return (value-low)%step == 0
+		}
+		low, err := strconv.Atoi(rangePart)
+		if err != nil || value < low || value > maxValue {
+			return false
+		}
+		return (value-low)%step == 0
+	}
+	// Handle ranges: 1-5
+	if lowText, highText, ok := strings.Cut(pattern, "-"); ok {
+		low, err1 := strconv.Atoi(lowText)
+		high, err2 := strconv.Atoi(highText)
+		if err1 != nil || err2 != nil {
+			return false
+		}
+		return value >= low && value <= high
+	}
+	// Handle wildcard
+	if pattern == "*" {
+		return true
+	}
+	// Handle literal value
+	v, err := strconv.Atoi(pattern)
+	if err != nil {
+		return false
+	}
+	return v == value
+}
+
+// cronDue checks whether a 5-field cron expression should fire at the given time.
+func cronDue(expr string, t time.Time) bool {
+	if !isCronExpr(expr) {
+		return false
+	}
+	fields := strings.Fields(expr)
+	if len(fields) != 5 {
+		return false
+	}
+	// Minute/hour/month must all match. When both day fields are restricted,
+	// standard cron ORs them: "0 9 1 * 1" fires on the 1st or on Mondays,
+	// rather than only when the 1st happens to be a Monday.
+	domRestricted := fields[2] != "*"
+	dowRestricted := fields[4] != "*"
+	domMatch := cronMatchField(fields[2], t.Day(), 1, 31)
+	// Standard cron allows 7 as a Sunday alias in the dow field (weekday is
+	// 0-6 in Go); a pattern like "0 9 * * 7" must still fire on Sundays.
+	weekday := int(t.Weekday())
+	dowMatch := cronMatchField(fields[4], weekday, 0, 7) || (weekday == 0 && cronMatchField(fields[4], 7, 0, 7))
+	dayMatch := !domRestricted || !dowRestricted
+	if domRestricted && dowRestricted {
+		dayMatch = domMatch || dowMatch
+	} else if domRestricted {
+		dayMatch = domMatch
+	} else if dowRestricted {
+		dayMatch = dowMatch
+	}
+	return cronMatchField(fields[0], t.Minute(), 0, 59) &&
+		cronMatchField(fields[1], t.Hour(), 0, 23) &&
+		dayMatch &&
+		cronMatchField(fields[3], int(t.Month()), 1, 12)
+}
+
+func scheduleDue(t Task, now time.Time) bool {
+	// Try cron expression first
+	if isCronExpr(t.Interval) {
+		if cronDue(t.Interval, now) {
+			if t.LastRunAt == 0 || time.UnixMilli(t.LastRunAt).Before(now.Truncate(time.Minute)) {
+				return true
+			}
+		}
+		return false
+	}
+
+	if scheduled, ok := previousHeartbeatScheduleAt(t, now); ok {
+		if t.CreatedAt != 0 && scheduled.Before(time.UnixMilli(t.CreatedAt)) {
+			return false
+		}
+		if t.LastRunAt != 0 && !time.UnixMilli(t.LastRunAt).Before(scheduled) {
+			return false
+		}
+		return !scheduled.After(now)
+	}
+
+	d, err := parseInterval(t.Interval)
+	if err != nil || d <= 0 {
+		return false
+	}
+	baseMillis := t.LastRunAt
+	if baseMillis == 0 {
+		baseMillis = t.CreatedAt
+	}
+	hasTimeWindow := t.TimeWindowStart != "" || t.TimeWindowEnd != ""
+	if baseMillis == 0 {
+		if hasTimeWindow {
+			return heartbeatWithinTimeWindow(t, now)
+		}
+		return true
+	}
+	if now.Sub(time.UnixMilli(baseMillis)) < d {
+		return false
+	}
+
+	// For interval-based tasks with a time window, check if current time
+	// falls within the configured window. If outside, defer until the next
+	// tick that falls within the window.
+	if hasTimeWindow {
+		return heartbeatWithinTimeWindow(t, now)
+	}
+
+	return true
+}
+
+// heartbeatWithinTimeWindow returns true when now falls within the task's
+// configured time window. If the window is empty it returns true.
+// Format: "HH:MM" in 24-hour clock; start inclusive, end exclusive.
+func heartbeatWithinTimeWindow(t Task, now time.Time) bool {
+	startH, startM, startOK := parseHeartbeatClock(t.TimeWindowStart)
+	endH, endM, endOK := parseHeartbeatClock(t.TimeWindowEnd)
+
+	if !startOK && !endOK {
+		return true // no window configured
+	}
+
+	minutes := now.Hour()*60 + now.Minute()
+
+	// If only start is set: allow from start to end of day
+	if startOK && !endOK {
+		return minutes >= startH*60+startM
+	}
+
+	// If only end is set: allow from midnight to end
+	if !startOK && endOK {
+		return minutes < endH*60+endM
+	}
+
+	startMin := startH*60 + startM
+	endMin := endH*60 + endM
+
+	if startMin < endMin {
+		// Normal window: 09:00-17:00
+		return minutes >= startMin && minutes < endMin
+	}
+	// Cross-midnight window: 22:00-06:00
+	return minutes >= startMin || minutes < endMin
+}
+
+type heartbeatSchedule struct {
+	kind     string
+	days     []time.Weekday
+	month    int
+	day      int
+	hour     int
+	minute   int
+	hasRules bool
+}
+
+func parseHeartbeatSchedule(interval string) (heartbeatSchedule, bool) {
+	_, after, ok0 := strings.Cut(interval, "|")
+	if !ok0 {
+		return heartbeatSchedule{}, false
+	}
+	raw := strings.TrimSpace(after)
+	if raw == "" {
+		return heartbeatSchedule{}, false
+	}
+	at := "09:00"
+	if parts := strings.SplitN(raw, "@", 2); len(parts) == 2 {
+		raw = parts[0]
+		at = parts[1]
+	}
+	hour, minute, ok := parseHeartbeatClock(at)
+	if !ok {
+		return heartbeatSchedule{}, false
+	}
+	kind := raw
+	rule := ""
+	if parts := strings.SplitN(raw, ":", 2); len(parts) == 2 {
+		kind = parts[0]
+		rule = parts[1]
+	}
+	s := heartbeatSchedule{kind: kind, hour: hour, minute: minute, hasRules: true}
+	switch kind {
+	case "daily":
+		return s, true
+	case "weekly", "biweekly":
+		for part := range strings.SplitSeq(rule, ",") {
+			if wd, ok := parseHeartbeatWeekday(part); ok {
+				s.days = append(s.days, wd)
+			}
+		}
+		return s, len(s.days) > 0
+	case "monthly":
+		s.day = parsePositiveInt(rule, 1)
+		return s, true
+	case "yearly":
+		parts := strings.SplitN(rule, "-", 2)
+		s.month = parsePositiveInt(firstString(parts), 1)
+		s.day = 1
+		if len(parts) == 2 {
+			s.day = parsePositiveInt(parts[1], 1)
+		}
+		if s.month < 1 {
+			s.month = 1
+		}
+		if s.month > 12 {
+			s.month = 12
+		}
+		return s, true
+	default:
+		return heartbeatSchedule{}, false
+	}
+}
+
+func previousHeartbeatScheduleAt(t Task, now time.Time) (time.Time, bool) {
+	s, ok := parseHeartbeatSchedule(t.Interval)
+	if !ok || !s.hasRules {
+		return time.Time{}, false
+	}
+	switch s.kind {
+	case "daily":
+		candidate := dateAt(now.Year(), now.Month(), now.Day(), s.hour, s.minute, now.Location())
+		if candidate.After(now) {
+			candidate = candidate.AddDate(0, 0, -1)
+		}
+		return candidate, true
+	case "weekly":
+		return previousHeartbeatWeeklyAt(s, now, 7, time.Time{})
+	case "biweekly":
+		anchor := heartbeatScheduleAnchor(t, now)
+		return previousHeartbeatWeeklyAt(s, now, 14, anchor)
+	case "monthly":
+		return previousHeartbeatMonthlyAt(s, now), true
+	case "yearly":
+		return previousHeartbeatYearlyAt(s, now), true
+	default:
+		return time.Time{}, false
+	}
+}
+
+func previousHeartbeatWeeklyAt(s heartbeatSchedule, now time.Time, windowDays int, anchor time.Time) (time.Time, bool) {
+	var best time.Time
+	for offset := range windowDays {
+		day := now.AddDate(0, 0, -offset)
+		for _, wd := range s.days {
+			if day.Weekday() != wd {
+				continue
+			}
+			candidate := dateAt(day.Year(), day.Month(), day.Day(), s.hour, s.minute, now.Location())
+			if candidate.After(now) {
+				continue
+			}
+			if !anchor.IsZero() && weeksBetween(weekStart(anchor), weekStart(candidate))%2 != 0 {
+				continue
+			}
+			if best.IsZero() || candidate.After(best) {
+				best = candidate
+			}
+		}
+	}
+	return best, !best.IsZero()
+}
+
+func previousHeartbeatMonthlyAt(s heartbeatSchedule, now time.Time) time.Time {
+	candidate := monthlyCandidate(now.Year(), now.Month(), s.day, s.hour, s.minute, now.Location())
+	if candidate.After(now) {
+		prev := now.AddDate(0, -1, 0)
+		candidate = monthlyCandidate(prev.Year(), prev.Month(), s.day, s.hour, s.minute, now.Location())
+	}
+	return candidate
+}
+
+func previousHeartbeatYearlyAt(s heartbeatSchedule, now time.Time) time.Time {
+	month := time.Month(s.month)
+	candidate := monthlyCandidate(now.Year(), month, s.day, s.hour, s.minute, now.Location())
+	if candidate.After(now) {
+		candidate = monthlyCandidate(now.Year()-1, month, s.day, s.hour, s.minute, now.Location())
+	}
+	return candidate
+}
+
+func heartbeatScheduleAnchor(t Task, now time.Time) time.Time {
+	if t.CreatedAt != 0 {
+		return time.UnixMilli(t.CreatedAt)
+	}
+	if t.LastRunAt != 0 {
+		return time.UnixMilli(t.LastRunAt)
+	}
+	return now
+}
+
+func parseHeartbeatClock(s string) (int, int, bool) {
+	parts := strings.SplitN(strings.TrimSpace(s), ":", 2)
+	if len(parts) != 2 {
+		return 0, 0, false
+	}
+	hour := parsePositiveInt(parts[0], -1)
+	minute := parsePositiveInt(parts[1], -1)
+	if hour < 0 || hour > 23 || minute < 0 || minute > 59 {
+		return 0, 0, false
+	}
+	return hour, minute, true
+}
+
+func parseHeartbeatWeekday(s string) (time.Weekday, bool) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "sun":
+		return time.Sunday, true
+	case "mon":
+		return time.Monday, true
+	case "tue":
+		return time.Tuesday, true
+	case "wed":
+		return time.Wednesday, true
+	case "thu":
+		return time.Thursday, true
+	case "fri":
+		return time.Friday, true
+	case "sat":
+		return time.Saturday, true
+	default:
+		return time.Sunday, false
+	}
+}
+
+func parsePositiveInt(s string, fallback int) int {
+	s = strings.TrimSpace(s)
+	if s == "" {
+		return fallback
+	}
+	n := 0
+	for _, r := range s {
+		if r < '0' || r > '9' {
+			return fallback
+		}
+		n = n*10 + int(r-'0')
+	}
+	return n
+}
+
+func firstString(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+	return values[0]
+}
+
+func dateAt(year int, month time.Month, day, hour, minute int, loc *time.Location) time.Time {
+	return time.Date(year, month, day, hour, minute, 0, 0, loc)
+}
+
+func monthlyCandidate(year int, month time.Month, day, hour, minute int, loc *time.Location) time.Time {
+	if day < 1 {
+		day = 1
+	}
+	if max := daysInMonth(year, month, loc); day > max {
+		day = max
+	}
+	return dateAt(year, month, day, hour, minute, loc)
+}
+
+func daysInMonth(year int, month time.Month, loc *time.Location) int {
+	return time.Date(year, month+1, 0, 0, 0, 0, 0, loc).Day()
+}
+
+func weekStart(t time.Time) time.Time {
+	dayOffset := (int(t.Weekday()) + 6) % 7
+	base := dateAt(t.Year(), t.Month(), t.Day(), 0, 0, t.Location())
+	return base.AddDate(0, 0, -dayOffset)
+}
+
+func weeksBetween(a, b time.Time) int {
+	// Compare civil dates in UTC rather than elapsed local hours. Local Monday
+	// midnights spanning DST can be 167 or 169 hours apart despite being exactly
+	// one calendar week apart.
+	aDay := time.Date(a.Year(), a.Month(), a.Day(), 0, 0, 0, 0, time.UTC)
+	bDay := time.Date(b.Year(), b.Month(), b.Day(), 0, 0, 0, 0, time.UTC)
+	if bDay.Before(aDay) {
+		aDay, bDay = bDay, aDay
+	}
+	return int(bDay.Sub(aDay) / (7 * 24 * time.Hour))
+}
diff --git a/internal/heartbeat/schedule_test.go b/internal/heartbeat/schedule_test.go
new file mode 100644
--- /dev/null
+++ b/internal/heartbeat/schedule_test.go
@@ -0,0 +1,62 @@
+package heartbeat
+
+import (
+	"testing"
+	"time"
+)
+
+func TestCalendarRulesTimezoneAndExpiry(t *testing.T) {
+	loc, err := time.LoadLocation("Asia/Shanghai")
+	if err != nil {
+		t.Fatal(err)
+	}
+	monday := time.Date(2026, 10, 19, 8, 0, 0, 0, loc)
+	for _, rule := range []string{"0 8 * * 1-5", "24h|daily@08:00", "168h|weekly:mon,wed@08:00"} {
+		t.Run(rule, func(t *testing.T) {
+			task := Task{Enabled: true, Interval: rule, Timezone: "Asia/Shanghai", CreatedAt: monday.Add(-time.Minute).UnixMilli()}
+			if task.Due(monday.Add(-time.Second)) {
+				t.Fatal("early dispatch")
+			}
+			if !task.Due(monday.UTC()) {
+				t.Fatal("did not use task timezone")
+			}
+			task.LastRunAt = monday.UnixMilli()
+			if task.Due(monday.Add(15 * time.Second)) {
+				t.Fatal("duplicate occurrence")
+			}
+			task.LastRunAt = 0
+			task.EndsAt = monday.Format(time.RFC3339)
+			if task.Due(monday) {
+				t.Fatal("expiry boundary is not exclusive")
+			}
+		})
+	}
+}
+func TestIntervalOnlyRunsWithinWindow(t *testing.T) {
+	loc, _ := time.LoadLocation("Asia/Shanghai")
+	task := Task{Enabled: true, Interval: "15m", Timezone: "Asia/Shanghai", TimeWindowStart: "08:00", TimeWindowEnd: "22:00", CreatedAt: time.Date(2026, 10, 22, 7, 0, 0, 0, loc).UnixMilli()}
+	if task.Due(time.Date(2026, 10, 22, 7, 59, 0, 0, loc)) {
+		t.Fatal("ran outside window")
+	}
+	if !task.Due(time.Date(2026, 10, 22, 8, 0, 0, 0, loc)) {
+		t.Fatal("missed window start")
+	}
+	if task.Due(time.Date(2026, 10, 22, 22, 0, 0, 0, loc)) {
+		t.Fatal("ran at excluded window end")
+	}
+}
+func TestRejectInvalidTask(t *testing.T) {
+	_, base, _ := fixture(t)
+	for _, change := range []func(*Task){
+		func(t *Task) { t.Interval = "5m" }, func(t *Task) { t.At = ""; t.Interval = "99 * * * *" },
+		func(t *Task) { t.Timezone = "Mars/Unknown" }, func(t *Task) { t.At = "tomorrow" },
+		func(t *Task) { t.Kind = "shell" }, func(t *Task) { t.ApprovalMode = "danger-full-access" },
+		func(t *Task) { t.Target = &Target{ChatID: "missing-connection"} },
+	} {
+		task := base
+		change(&task)
+		if task.Validate() == nil {
+			t.Fatalf("accepted invalid task: %+v", task)
+		}
+	}
+}
diff --git a/internal/heartbeat/store.go b/internal/heartbeat/store.go
new file mode 100644
--- /dev/null
+++ b/internal/heartbeat/store.go
@@ -0,0 +1,134 @@
+package heartbeat
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"reasonix/internal/fileutil"
+	"reasonix/internal/identitylock"
+)
+
+type document struct {
+	Version int    `json:"schemaVersion"`
+	Tasks   []Task `json:"tasks"`
+}
+
+// Store owns the headless task file, separate from desktop heartbeat state.
+type Store struct{ Path string }
+
+// List returns a consistent snapshot without changing task state.
+func (s Store) List(ctx context.Context) ([]Task, error) {
+	var tasks []Task
+	err := s.locked(ctx, false, func(d *document) error {
+		tasks = d.Tasks
+		return nil
+	})
+	return tasks, err
+}
+
+// Edit serializes read-modify-write across processes and publishes atomically.
+func (s Store) Edit(ctx context.Context, edit func(*[]Task) error) error {
+	return s.locked(ctx, true, func(d *document) error { return edit(&d.Tasks) })
+}
+
+func (s Store) locked(ctx context.Context, write bool, action func(*document) error) error {
+	if s.Path == "" {
+		return errors.New("heartbeat store path is empty")
+	}
+	if err := os.MkdirAll(filepath.Dir(s.Path), 0o700); err != nil {
+		return err
+	}
+	lockCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	release, err := identitylock.Acquire(lockCtx, s.Path+".lock")
+	if err != nil {
+		return err
+	}
+	defer release()
+	d, err := s.read()
+	if err != nil {
+		return err
+	}
+	if err := action(&d); err != nil || !write {
+		return err
+	}
+	b, err := json.MarshalIndent(d, "", "  ")
+	if err != nil {
+		return err
+	}
+	if len(b) > 8<<20 {
+		return errors.New("heartbeat store exceeds 8 MiB; remove old task history before retrying")
+	}
+	return fileutil.AtomicWriteFileStrict(s.Path, b, 0o600)
+}
+
+func (s Store) read() (document, error) {
+	d := document{Version: 1, Tasks: []Task{}}
+	info, err := os.Stat(s.Path)
+	if errors.Is(err, os.ErrNotExist) {
+		return d, nil
+	}
+	if err != nil {
+		return d, err
+	}
+	if info.Size() > 8<<20 {
+		return d, errors.New("heartbeat store exceeds 8 MiB")
+	}
+	b, err := os.ReadFile(s.Path)
+	if err != nil {
+		return d, err
+	}
+	if err := json.Unmarshal(b, &d); err != nil {
+		return d, fmt.Errorf("read heartbeat store: %w", err)
+	}
+	if d.Version != 1 {
+		return d, fmt.Errorf("unsupported heartbeat schema %d", d.Version)
+	}
+	seen := map[string]bool{}
+	for _, task := range d.Tasks {
+		if err := task.Validate(); err != nil {
+			return d, fmt.Errorf("task %q: %w", task.ID, err)
+		}
+		if seen[task.ID] {
+			return d, fmt.Errorf("duplicate heartbeat task %q", task.ID)
+		}
+		seen[task.ID] = true
+	}
+	return d, nil
+}
+
+// Add persists a validated new task without replacing an existing identity.
+func (s Store) Add(ctx context.Context, task Task) error {
+	if err := task.Validate(); err != nil {
+		return err
+	}
+	if err := task.validateWorkspace(); err != nil {
+		return err
+	}
+	return s.Edit(ctx, func(tasks *[]Task) error {
+		for _, existing := range *tasks {
+			if existing.ID == task.ID {
+				return fmt.Errorf("task %q already exists", task.ID)
+			}
+		}
+		*tasks = append(*tasks, task)
+		return nil
+	})
+}
+
+// Update changes one current task; deletion while work runs is never resurrected.
+func (s Store) Update(ctx context.Context, id string, edit func(*Task) error) error {
+	return s.Edit(ctx, func(tasks *[]Task) error {
+		for i := range *tasks {
+			if (*tasks)[i].ID == id {
+				return edit(&(*tasks)[i])
+			}
+		}
+		return fmt.Errorf("heartbeat task %q not found", id)
+	})
+}
diff --git a/internal/heartbeat/task.go b/internal/heartbeat/task.go
new file mode 100644
--- /dev/null
+++ b/internal/heartbeat/task.go
@@ -0,0 +1,131 @@
+package heartbeat
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	_ "time/tzdata" // Servers need IANA zones even without a system zone database.
+)
+
+// Target identifies exactly one explicitly selected notification destination.
+type Target struct {
+	ConnectionID string `json:"connection_id"`
+	Domain       string `json:"domain,omitempty"`
+	ChatID       string `json:"chat_id"`
+	ChatType     string `json:"chat_type,omitempty"`
+}
+
+// Run records execution separately from delivery; pending delivery never reruns AI.
+type Run struct {
+	StartedAt int64  `json:"startedAt"`
+	EndedAt   int64  `json:"endedAt,omitempty"`
+	Status    string `json:"status"`
+	Result    string `json:"result,omitempty"`
+	SessionID string `json:"sessionId,omitempty"`
+	Error     string `json:"error,omitempty"`
+}
+
+// Task is a persisted headless job. Calendar rules use the desktop interval syntax.
+type Task struct {
+	ID                     string  `json:"id"`
+	Title                  string  `json:"title"`
+	Prompt                 string  `json:"prompt"`
+	Interval               string  `json:"interval,omitempty"`
+	At                     string  `json:"at,omitempty"`
+	Timezone               string  `json:"timezone"`
+	EndsAt                 string  `json:"endsAt,omitempty"`
+	Enabled                bool    `json:"enabled"`
+	WorkspaceRoot          string  `json:"workspaceRoot"`
+	Model                  string  `json:"model,omitempty"`
+	ApprovalMode           string  `json:"approvalMode"`
+	Kind                   string  `json:"kind"`
+	NewConversationEachRun bool    `json:"newConversationEachRun"`
+	TimeWindowStart        string  `json:"timeWindowStart,omitempty"`
+	TimeWindowEnd          string  `json:"timeWindowEnd,omitempty"`
+	CreatedAt              int64   `json:"createdAt"`
+	LastRunAt              int64   `json:"lastRunAt,omitempty"`
+	Target                 *Target `json:"target,omitempty"`
+	History                []Run   `json:"history,omitempty"`
+}
+
+// Validate rejects ambiguous schedules and unsupported unattended permissions.
+func (t Task) Validate() error {
+	if t.ID == "" || strings.TrimSpace(t.Title) == "" || strings.TrimSpace(t.Prompt) == "" {
+		return errors.New("id, title and prompt are required")
+	}
+	if (t.At == "") == (t.Interval == "") {
+		return errors.New("set exactly one of at or interval")
+	}
+	if _, err := time.LoadLocation(t.Timezone); err != nil {
+		return fmt.Errorf("timezone: %w", err)
+	}
+	if t.Kind != "agent" && t.Kind != "message" {
+		return errors.New("kind must be agent or message")
+	}
+	if t.ApprovalMode != "read-only" && t.ApprovalMode != "workspace-write" {
+		return errors.New("approvalMode must be read-only or workspace-write")
+	}
+	if !filepath.IsAbs(t.WorkspaceRoot) {
+		return errors.New("workspaceRoot must be an absolute path")
+	}
+	return t.validateSchedule()
+}
+
+func (t Task) validateWorkspace() error {
+	if info, err := os.Stat(t.WorkspaceRoot); err != nil || !info.IsDir() {
+		return errors.New("workspaceRoot must be an existing directory")
+	}
+	return nil
+}
+
+func (t Task) validateSchedule() error {
+	for _, value := range []string{t.At, t.EndsAt} {
+		if value != "" {
+			if _, err := time.Parse(time.RFC3339, value); err != nil {
+				return fmt.Errorf("time must be RFC3339 with offset: %w", err)
+			}
+		}
+	}
+	if t.Interval != "" && !isCronExpr(t.Interval) {
+		if _, ok := parseHeartbeatSchedule(t.Interval); !ok {
+			d, err := parseInterval(t.Interval)
+			if err != nil || d <= 0 || strings.Contains(t.Interval, "|") {
+				return errors.New("invalid interval/calendar rule")
+			}
+		}
+	}
+	for _, value := range []string{t.TimeWindowStart, t.TimeWindowEnd} {
+		if value != "" {
+			if _, _, ok := parseHeartbeatClock(value); !ok {
+				return errors.New("time window must use HH:MM")
+			}
+		}
+	}
+	if t.Target != nil && (t.Target.ConnectionID == "" || t.Target.ChatID == "") {
+		return errors.New("notification target requires connection_id and chat_id")
+	}
+	return nil
+}
+
+// Due checks expiry on every dispatch; expired jobs do not need a cleanup tick.
+func (t Task) Due(now time.Time) bool {
+	if !t.Enabled || t.Expired(now) {
+		return false
+	}
+	if t.At != "" {
+		at, err := time.Parse(time.RFC3339, t.At)
+		return err == nil && !now.Before(at) && t.LastRunAt == 0
+	}
+	loc, err := time.LoadLocation(t.Timezone)
+	return err == nil && scheduleDue(t, now.In(loc))
+}
+
+// Expired reports whether the exclusive end boundary has been reached.
+func (t Task) Expired(now time.Time) bool {
+	end, err := time.Parse(time.RFC3339, t.EndsAt)
+	return err == nil && !now.Before(end)
+}
