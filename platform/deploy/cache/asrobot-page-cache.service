[Unit]
Description=AS Robot disposable page cache Redis (private socket)
After=local-fs.target
[Service]
Type=simple
User=redis
Group=asrobot-history
RuntimeDirectory=asrobot-page-cache
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/redis-server --port 0 --unixsocket /run/asrobot-page-cache/redis.sock --unixsocketperm 770 --save "" --appendonly no --maxmemory 64mb --maxmemory-policy allkeys-lru --maxclients 64
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M
TasksMax=16
[Install]
WantedBy=multi-user.target
