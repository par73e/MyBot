# Template only. Issue and verify the named certificate and DNS before use.
# Keep the existing shared virtual host and other sites intact.
server {
    listen 80;
    server_name assistant.example.com;
    return 308 https://assistant.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name assistant.example.com;
    ssl_certificate /etc/letsencrypt/live/assistant.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/assistant.example.com/privkey.pem;
    location = / { return 302 /asrobot/; }
    location = /asrobot { return 301 /asrobot/; }
    location ^~ /asrobot/ {
        proxy_pass http://127.0.0.1:18980;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 200s;
        proxy_connect_timeout 5s;
        client_max_body_size 64k;
        access_log off;
    }
}
